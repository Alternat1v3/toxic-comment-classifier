# Copy this file to server/.env and adjust. Every value has a safe default for local development.

# Never deploy with DEBUG on. A secret key is required when DEBUG is off:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Where the React app runs (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: use Redis for WebSockets (needed with more than one server process).
# Without it, an in-memory channel layer is used.
REDIS_URL=

# Folder with the fine-tuned BERT model (config.json, model.safetensors, vocab.txt).
# Defaults to ../ml/model. Without it, messages are checked with the keyword list.
TOXICITY_MODEL_DIR=

# CPU threads for the model. Defaults to every core.
TORCH_THREADS=
